// Publicação no Cloudflare (Workers com arquivos estáticos). Passo a passo no README, seção "Cloudflare".
{
  "name": "financeiro",
  "main": "worker/index.ts",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Rotas do React (ex.: /lancamentos) devolvem o index.html.
    "not_found_handling": "single-page-application",
    // Só /api passa pelo Worker; o resto é servido direto como arquivo estático.
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    // Endereço público do backend (Render). O segredo PROXY_SECRET é configurado à parte:
    //   npx wrangler secret put PROXY_SECRET
    "BACKEND_ORIGIN": "https://moneylens-psxa.onrender.com",
  },
  "observability": { "enabled": true },
  // Endereço do app. O domínio está na mesma conta do Cloudflare, que cria o DNS e o certificado sozinho.
  "routes": [{ "pattern": "moneylens.jpaulos.dev", "custom_domain": true }],
  // O endereço antigo (*.workers.dev) continua durante a transição; para desligar depois: false.
  "workers_dev": true,
}
